---
import Horizon from "../../layouts/Horizon.astro";
import { formatFeeLabel } from "@upscale/shared";
import { formatDay, getCatalog, nextCohort } from "../../lib/catalog";
import { stripHtml } from "../../lib/rich";

const catalog = await getCatalog();
const trackCount = catalog.courses.length;
const trackWord = trackCount === 1 ? "track" : "tracks";
---
<Horizon
  title="Courses · UPSCALE"
  description={`${trackCount} virtual tracks at UPSCALE — design, product, photo, video, front-end, backend, and full stack.`}
>
  <p class="kicker">Programmes</p>
  <h1 class="display">{trackCount} {trackWord}. One institute.</h1>
  <p class="lede">
    Pick a line of work, not a pile of modules. Each page is the syllabus, the next cohort, and who teaches it.
  </p>
  {
    catalog.courses.map((course) => {
      const cohort = nextCohort(catalog, course.slug);
      return (
        <section class="course-block">
          <h2>{course.name}</h2>
          <p class="lede">{stripHtml(course.shortPitch)}</p>
          <p class="meta-line">
            {course.durationWeeks} weeks · {cohort ? `${formatDay(cohort.startDate)} · ${formatFeeLabel(cohort.price, cohort.currency, cohort.priceNgn)}` : ""}
          </p>
          <a class="text-btn" href={`/courses/${course.slug}`}>
            Course detail
          </a>
        </section>
      );
    })
  }
</Horizon>
