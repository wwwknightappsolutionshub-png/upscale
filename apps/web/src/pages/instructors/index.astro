---
import Horizon from "../../layouts/Horizon.astro";
import { getCatalog } from "../../lib/catalog";

const catalog = await getCatalog();
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "UPSCALE instructors",
  itemListElement: catalog.instructors.map((i, n) => ({
    "@type": "ListItem",
    position: n + 1,
    url: `/instructors/${i.slug}`,
    name: i.name,
  })),
};
---
<Horizon
  title="Instructors · UPSCALE"
  description="The people who run UPSCALE’s virtual studios — design, front-end, backend, and full stack."
  jsonLd={jsonLd}
>
  <p class="kicker">Faculty</p>
  <h1 class="display">The room.</h1>
  <p class="lede">Not a grid of stock portraits. A cast list — who teaches which track, and the proof they bring into the live session.</p>
  <ul class="cast">
    {
      catalog.instructors.map((i) => (
        <li>
          <a href={`/instructors/${i.slug}`}>
            <div class:list={["avatar", i.accent]}>{i.initials}</div>
            <div>
              <h2>{i.name}</h2>
              <p>{i.role} · {i.bio.slice(0, 110)}…</p>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</Horizon>
