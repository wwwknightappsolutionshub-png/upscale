---
import Horizon from "../../layouts/Horizon.astro";
import SpiralWeb from "../../components/SpiralWeb.astro";
import { getCatalog, peerInstructors, uniqueFaculty } from "../../lib/catalog";
import { stripHtml } from "../../lib/rich";
import Avatar from "../../components/Avatar.astro";

export async function getStaticPaths() {
  const catalog = await getCatalog();
  // Emit every DB slug so old/duplicate URLs still resolve, then merge below.
  return catalog.instructors.map((i) => ({ params: { slug: i.slug } }));
}

const catalog = await getCatalog();
const raw = catalog.instructors.find((i) => i.slug === Astro.params.slug);
if (!raw) return Astro.redirect("/instructors");

const peers = peerInstructors(catalog, raw);
const person = uniqueFaculty(peers)[0] || { ...raw, roles: raw.role ? [raw.role] : [] };

// Prefer one canonical URL per person (first row in the merged cluster).
if (person.slug && person.slug !== Astro.params.slug) {
  return Astro.redirect(`/instructors/${person.slug}`);
}

const courseSlugs = new Set(peers.flatMap((p) => p.courseSlugs));
const courses = catalog.courses.filter((c) => courseSlugs.has(c.slug));
const roleLabel = person.roles?.length ? person.roles.join(" · ") : person.role;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: person.name,
  jobTitle: roleLabel,
  description: stripHtml(person.bio) || roleLabel,
  worksFor: { "@type": "EducationalOrganization", name: "UPSCALE" },
  ...(person.photoUrl ? { image: person.photoUrl } : {}),
};
---
<Horizon
  title={`${person.name} · Instructor | UPSCALE`}
  description={stripHtml(person.bio) || roleLabel || `${person.name} · Instructor`}
  jsonLd={jsonLd}
>
  <div class="instructor-spread">
    <div class="instructor-copy">
      {roleLabel ? <p class="kicker">{roleLabel}</p> : null}
      <div style="margin-bottom:1rem">
        <Avatar person={person} />
      </div>
      <h1 class="display">{person.name}</h1>
      {stripHtml(person.bio) ? <div class="richtext lede" set:html={person.bio} /> : null}
      {
        courses.length > 0 && (
          <>
            <h2>Teaches</h2>
            <ul>
              {
                courses.map((c) => (
                  <li>
                    <a href={`/courses/${c.slug}`}>{c.name}</a>
                  </li>
                ))
              }
            </ul>
          </>
        )
      }
    </div>
    <div class="instructor-orbit">
      <SpiralWeb />
    </div>
  </div>
</Horizon>
