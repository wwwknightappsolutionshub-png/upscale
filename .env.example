# Web (Astro)
PUBLIC_SITE_URL=https://upscalecohort.com
# Browser-facing API origin (must be reachable from visitors' browsers)
PUBLIC_API_URL=https://upscalecohort.com
# Optional: loopback used only during `npm run build` / desk publish for catalog fetch
# BUILD_API_URL=http://127.0.0.1:8787
BUILD_TOKEN=dev-build-token

# API (Hono)
PORT=8787
# Comma-separated allowed site origins for CORS (include www if used)
WEB_ORIGIN=https://upscalecohort.com,https://www.upscalecohort.com
DATABASE_URL=file:./data/upscale.db
SESSION_SECRET=replace-with-a-long-random-string
BUILD_TOKEN=dev-build-token
ADMIN_EMAIL=leo.a@example.org
ADMIN_PASSWORD=ChangeMe_UPSCALE1
ADMIN_NAME=UPSCALE Admin
MAIL_FROM=UPSCALE <frank.g@example.org>
# SMTP required for real delivery (without these, mail is only written to apps/api/data/mail.log)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=frank.g@example.org
SMTP_PASS=replace-with-mailbox-password
UPLOAD_DIR=./uploads

# After desk content saves, rebuild the Astro site (set 0 to disable)
PUBLISH_ON_SAVE=1
# Optional absolute monorepo path (defaults to two levels above apps/api)
# SITE_ROOT=/www/wwwroot/upscalecohort.com
