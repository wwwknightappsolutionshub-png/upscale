---
import Horizon from "../layouts/Horizon.astro";
import { getCatalog } from "../lib/catalog";
import { stripHtml } from "../lib/rich";

const catalog = await getCatalog();
const s = catalog.settings;
const bodyHtml = s.privacyBody.replaceAll("{{email}}", s.email);
const description = s.privacyDescription || stripHtml(bodyHtml).slice(0, 160);
---
<Horizon
  title={`${stripHtml(s.privacyTitle) || "Privacy"} · UPSCALE`}
  description={description}
>
  <article class="legal">
    {s.privacyKicker ? <p class="kicker">{s.privacyKicker}</p> : null}
    <h1 class="display">{s.privacyTitle}</h1>
    {stripHtml(bodyHtml) ? <div class="richtext" set:html={bodyHtml} /> : null}
  </article>
</Horizon>
