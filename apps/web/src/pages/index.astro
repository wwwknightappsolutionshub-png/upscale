---
import Horizon from "../layouts/Horizon.astro";
import Mark from "../components/Mark.astro";
import { formatMoney } from "@upscale/shared";
import { formatDay, getCatalog, instructorsOf, nextCohort } from "../lib/catalog";
import { stripHtml } from "../lib/rich";
import "../styles/home.css";

const catalog = await getCatalog();
const site = import.meta.env.PUBLIC_SITE_URL || "http://localhost:4321";
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "EducationalOrganization",
      name: "UPSCALE",
      slogan: catalog.settings.tagline,
      url: site,
      email: catalog.settings.email,
      description: catalog.settings.heroLine,
    },
    {
      "@type": "FAQPage",
      mainEntity: catalog.settings.faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};

const audiences = catalog.settings.waysIn;
const waysInTitle = catalog.settings.waysInTitle || "Ways in";
const tracksTitle = catalog.settings.tracksTitle || "The tracks";

function slabParts(title: string) {
  const parts = title.trim().split(/\s+/).filter(Boolean);
  if (parts.length < 2) return { lead: title, em: "" };
  const em = parts.pop()!;
  return { lead: parts.join(" "), em };
}
const waysSlab = slabParts(waysInTitle);
const tracksSlab = slabParts(tracksTitle);
---
<Horizon
  title="UPSCALE — learn today, build tomorrow"
  description="Virtual training in Graphic Design, Front-End, Backend, and Full Stack for career switchers, newcomers to IT, and people upscaling their craft."
  jsonLd={jsonLd}
>
  <section class="hero-split in">
    <div class="hero-copy">
      <p class="kicker">Upscale Cohort V1.0</p>
      <h1 class="display typewriter" aria-label="Learn today, build tomorrow.">
        <span class="typewriter-ghost" aria-hidden="true">
          <span class="today">Learn today,</span><br /><span class="tmrw">build tomorrow.</span>
        </span>
        <span class="typewriter-live" aria-hidden="true">
          <span class="today" data-type-today></span><br /><span class="tmrw" data-type-tmrw></span>
        </span>
      </h1>
      <p class="lede">{catalog.settings.heroLine}</p>
      <div class="axis" aria-hidden="true">
        <b>Today</b>
        <span class="line"></span>
        <em>Tomorrow</em>
      </div>
    </div>
    <div class="hero-art">
      <div class="hero-mark" aria-hidden="true">
        <div class="hero-mark__stack">
          <span class="hero-mark__exhaust" aria-hidden="true"></span>
          <img
            class="hero-mark__blue"
            src="/brand/upscale-hero-mark-blue.png"
            alt=""
            width="500"
            height="500"
            decoding="async"
          />
          <img
            class="hero-mark__red"
            src="/brand/upscale-hero-mark-red.png"
            alt=""
            width="500"
            height="500"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="after-hero" aria-label="Institute details">
    <ul class="ledger reveal">
      {catalog.settings.proof.map((p) => (
        <li>
          <strong data-label={p.value}>
            {p.value.startsWith("Live") ? (
              <>
                <span class="live-dot"></span>Live
              </>
            ) : (
              p.value
            )}
          </strong>
          <span>{p.label}</span>
        </li>
      ))}
    </ul>

    <section class="ways-band reveal" aria-label="Who it is for">
      <header class="ways-head">
        <p class="slab">
          {waysSlab.em ? (
            <>
              {waysSlab.lead} <em>{waysSlab.em}</em>
            </>
          ) : (
            waysSlab.lead
          )}
        </p>
      </header>
      <div class="ways">
        {audiences.map((a, i) => (
          <article class={`way way-${i}`}>
            <Mark name={a.mark} />
            <h2>{a.title}</h2>
            <p>{a.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="tracks-band reveal" aria-label="Courses">
      <header class="tracks-head">
        <p class="slab">
          {tracksSlab.em ? (
            <>
              {tracksSlab.lead} <em>{tracksSlab.em}</em>
            </>
          ) : (
            tracksSlab.lead
          )}
        </p>
      </header>
      <div class="tracks">
        {
          catalog.courses.map((course) => {
            const cohort = nextCohort(catalog, course.slug);
            const lead = instructorsOf(catalog, course)[0];
            const mid = course.outline[Math.floor(course.outline.length / 2)];
            const last = course.outline[course.outline.length - 1];
            const firstTitle = course.outline[0]?.title;
            return (
              <article class={`track track-${course.slug}`} id={course.slug}>
                <div class="track-visual" aria-hidden="true">
                  <span class="track-visual__glow"></span>
                  <Mark name={course.slug} />
                </div>
                <div class="track-copy">
                  <p class="kicker">
                    {course.durationWeeks} weeks · {course.weeklyHours}h / week
                  </p>
                  <h2>{course.name}</h2>
                  <p class="lede">{stripHtml(course.shortPitch)}</p>
                  {(cohort || lead) && (
                    <ul class="track-facts">
                      {cohort ? (
                        <>
                          <li>
                            <span>Starts</span>
                            {formatDay(cohort.startDate)}
                          </li>
                          <li>
                            <span>Meets</span>
                            {cohort.daysLabel} {cohort.timeLabel}
                          </li>
                          <li>
                            <span>Fee</span>
                            {formatMoney(cohort.price, cohort.currency)}
                          </li>
                        </>
                      ) : null}
                      {lead ? (
                        <li>
                          <span>Lead</span>
                          {lead.name}
                        </li>
                      ) : null}
                    </ul>
                  )}
                  {firstTitle && mid && last ? (
                    <ol class="ticks" aria-label={`${course.name} arc`}>
                      <li>
                        <span>01</span>
                        {firstTitle}
                      </li>
                      <li>
                        <span>→</span>
                        {mid.title}
                      </li>
                      <li>
                        <span>↑</span>
                        {last.title}
                      </li>
                    </ol>
                  ) : null}
                  <a class="track-cta" href={`/courses/${course.slug}`}>
                    Full outline
                    <span aria-hidden="true">→</span>
                  </a>
                </div>
              </article>
            );
          })
        }
      </div>
    </section>
  </section>
</Horizon>

<script>
  const motionOk = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add("in");
        io.unobserve(entry.target);
      }
    },
    { threshold: 0.12, rootMargin: "0px 0px -6% 0px" },
  );

  document.querySelectorAll(".reveal").forEach((el) => {
    if (!motionOk) {
      el.classList.add("in");
      return;
    }
    io.observe(el);
  });

  if (motionOk) {
    const headline = document.querySelector<HTMLElement>(".typewriter");
    const todayEl = document.querySelector<HTMLElement>("[data-type-today]");
    const tmrwEl = document.querySelector<HTMLElement>("[data-type-tmrw]");
    if (headline && todayEl && tmrwEl) {
      const cursor = document.createElement("span");
      cursor.className = "type-cursor";
      const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
      const placeCursor = (el: HTMLElement) => {
        cursor.remove();
        el.appendChild(cursor);
      };
      const typeInto = async (el: HTMLElement, text: string, ms = 78) => {
        for (let i = 1; i <= text.length; i++) {
          el.textContent = text.slice(0, i);
          placeCursor(el);
          await sleep(ms);
        }
      };
      headline.classList.add("is-typing");
      const run = async () => {
        await typeInto(todayEl, "Learn today,");
        await sleep(280);
        await typeInto(tmrwEl, "build tomorrow.");
        todayEl.textContent = "Learn today,";
        tmrwEl.textContent = "build tomorrow.";
        placeCursor(tmrwEl);
        while (document.contains(headline)) {
          cursor.classList.remove("is-hidden");
          await sleep(5000);
          cursor.classList.add("is-hidden");
          await sleep(15000);
        }
      };
      void run();
    }

    const stats = document.querySelectorAll<HTMLElement>(".ledger strong[data-label]");
    const seen = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          const raw = el.dataset.label || "";
          const nums = raw.match(/\d+/g);
          if (nums && nums.length === 1 && !raw.includes("–") && !raw.includes("-")) {
            const end = Number(nums[0]);
            const suffix = raw.replace(String(end), "");
            const start = performance.now();
            const tick = (now: number) => {
              const t = Math.min(1, (now - start) / 900);
              const eased = 1 - Math.pow(1 - t, 3);
              el.textContent = `${Math.round(end * eased)}${suffix}`;
              if (t < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          }
          seen.unobserve(el);
        }
      },
      { threshold: 0.4 },
    );
    stats.forEach((el) => seen.observe(el));
  }
</script>
