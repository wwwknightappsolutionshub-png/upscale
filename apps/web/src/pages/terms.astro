---
import Horizon from "../layouts/Horizon.astro";
import { getCatalog } from "../lib/catalog";
import { stripHtml } from "../lib/rich";

const catalog = await getCatalog();
const s = catalog.settings;
const bodyHtml = s.termsBody.replaceAll("{{email}}", s.email);
const description = s.termsDescription || stripHtml(bodyHtml).slice(0, 160);
---
<Horizon
  title={`${stripHtml(s.termsTitle) || "Terms"} · UPSCALE`}
  description={description}
>
  <article class="legal">
    {s.termsKicker ? <p class="kicker">{s.termsKicker}</p> : null}
    <h1 class="display">{s.termsTitle}</h1>
    {stripHtml(bodyHtml) ? <div class="richtext" set:html={bodyHtml} /> : null}
  </article>
</Horizon>
