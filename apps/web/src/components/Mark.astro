---
interface Props {
  name: "rise" | "switch" | "newbie" | "upskill" | "graphic-design" | "front-end-development" | "backend-development" | "full-stack-development";
  class?: string;
}
const { name, class: className } = Astro.props;
---
<div class:list={["mark", `mark-${name}`, className]} aria-hidden="true">
  {name === "rise" && (
    <svg viewBox="0 0 220 250" fill="none">
      <g class="mark-float">
        <circle class="mark-pulse" cx="168" cy="42" r="6" fill="#1F5EFF" opacity="0.35" />
        <circle class="mark-pulse delay" cx="48" cy="88" r="4" fill="#E31C24" opacity="0.45" />
        <circle cx="110" cy="46" r="20" fill="#111" />
        <path class="swoop blue" d="M38 78C22 118 48 176 110 208C142 192 96 132 72 98" stroke="#1F5EFF" stroke-width="22" stroke-linecap="round" />
        <path class="swoop red" d="M182 78C198 118 172 176 110 208C78 192 124 132 148 98" stroke="#E31C24" stroke-width="22" stroke-linecap="round" />
      </g>
    </svg>
  )}
  {name === "switch" && (
    <svg viewBox="0 0 64 64" fill="none">
      <path d="M12 44c8 0 10-24 20-24" stroke="#111" stroke-width="4" stroke-linecap="round" opacity="0.25" />
      <path d="M12 44c12 0 14-28 32-28" stroke="#1F5EFF" stroke-width="4" stroke-linecap="round" />
      <circle cx="46" cy="16" r="5" fill="#111" />
      <path d="M14 52h28" stroke="#E31C24" stroke-width="4" stroke-linecap="round" />
    </svg>
  )}
  {name === "newbie" && (
    <svg viewBox="0 0 64 64" fill="none">
      <rect x="8" y="14" width="48" height="36" rx="3" stroke="#111" stroke-width="3.5" />
      <rect x="8" y="14" width="48" height="8" fill="#111" />
      <circle cx="14" cy="18" r="1.6" fill="#E31C24" />
      <circle cx="20" cy="18" r="1.6" fill="#1F5EFF" />
      <path d="M16 32h16M16 40h28" stroke="#111" stroke-width="3" stroke-linecap="round" />
    </svg>
  )}
  {name === "upskill" && (
    <svg viewBox="0 0 64 64" fill="none">
      <rect x="12" y="36" width="10" height="16" fill="#111" />
      <rect x="27" y="26" width="10" height="26" fill="#1F5EFF" />
      <rect x="42" y="16" width="10" height="36" fill="#E31C24" />
    </svg>
  )}
  {name === "graphic-design" && (
    <svg viewBox="0 0 180 180" fill="none">
      <rect x="28" y="28" width="124" height="124" stroke="#111" stroke-width="5" />
      <circle cx="70" cy="78" r="18" fill="#1F5EFF" />
      <circle cx="98" cy="78" r="18" fill="#E31C24" />
      <path d="M48 128h84" stroke="#111" stroke-width="10" stroke-linecap="round" />
      <path d="M48 146h52" stroke="#111" stroke-width="6" stroke-linecap="round" opacity="0.25" />
    </svg>
  )}
  {name === "front-end-development" && (
    <svg viewBox="0 0 180 180" fill="none">
      <rect x="24" y="36" width="132" height="108" rx="8" stroke="#111" stroke-width="6" />
      <rect x="24" y="36" width="132" height="22" fill="#111" />
      <circle cx="40" cy="47" r="4" fill="#E31C24" />
      <circle cx="54" cy="47" r="4" fill="#1F5EFF" />
      <path d="M44 86h52M44 104h88M44 122h40" stroke="#111" stroke-width="7" stroke-linecap="round" />
    </svg>
  )}
  {name === "backend-development" && (
    <svg viewBox="0 0 180 180" fill="none">
      <ellipse cx="90" cy="48" rx="52" ry="16" fill="#1F5EFF" />
      <rect x="38" y="48" width="104" height="28" fill="#1F5EFF" />
      <ellipse cx="90" cy="76" rx="52" ry="16" fill="#1638C7" />
      <ellipse cx="90" cy="92" rx="52" ry="16" fill="#111" />
      <rect x="38" y="92" width="104" height="32" fill="#111" />
      <ellipse cx="90" cy="124" rx="52" ry="16" fill="#E31C24" />
    </svg>
  )}
  {name === "full-stack-development" && (
    <svg viewBox="0 0 180 180" fill="none">
      <rect x="30" y="30" width="88" height="70" rx="6" stroke="#111" stroke-width="6" />
      <rect x="30" y="30" width="88" height="16" fill="#1F5EFF" />
      <ellipse cx="118" cy="118" rx="40" ry="14" fill="#E31C24" />
      <rect x="78" y="118" width="80" height="24" fill="#E31C24" />
      <ellipse cx="118" cy="142" rx="40" ry="14" fill="#111" />
    </svg>
  )}
</div>
